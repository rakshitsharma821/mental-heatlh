# ============================================
# MindCare Sanctuary — Environment Configuration Template
# All secrets and URLs must be provided via environment variables.
# Zero hardcoded keys or production secrets in source code.
# ============================================

# ── 1. Server & Networking ──
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# ── 2. PostgreSQL Database Connection ──
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=mindcare_db
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password_here
DATABASE_URL=postgresql://postgres:your_secure_postgres_password_here@127.0.0.1:5432/mindcare_db

# ── 3. Core Cryptography & Security ──
JWT_SECRET=mindcare_sanctuary_super_secret_jwt_key_2026_botanical
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── 4. OpenRouter AI Companion (Aria) ──
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning:free
AI_FALLBACK_RULE_BASED=true

# ── 5. OTP Telephony & Authentication Controls ──
OTP_PROVIDER=console
OTP_TEST_STATIC_CODE=123456
CLIENT_OTP_REQUIRED=false
ADMIN_OTP_REQUIRED=true

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
FAST2SMS_API_KEY=

# ── 6. Super Admin Seed Configuration ──
ADMIN_PUBLIC_ID=ADM-SANCTUARY-01
ADMIN_EMAIL=admin@mindcare.com
ADMIN_NAME=Super Administrator
ADMIN_INITIAL_PASSWORD=SanctuarySuperAdmin2026!
ADMIN_INITIAL_ACCESS_CODE=SANCTUARY-AUTH-KEY-99

# ── 7. Clinician Document Vault & Upload Settings ──
STORAGE_TYPE=local
UPLOAD_DIR=./uploads/therapist_vault
MAX_FILE_SIZE_MB=15
ALLOWED_DOC_TYPES=application/pdf,image/jpeg,image/png

# ── 8. WebRTC Live Room & ICE Servers (Consultation Calls) ──
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=
TURN_USERNAME=
TURN_CREDENTIAL=

# ── 9. Rate Limiting, TTL & Mindful Windows ──
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME_SECONDS=30
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
COMPANION_WORD_TTL_HOURS=24
SESSION_TIMEOUT_MINUTES=60
QUIET_HOURS_START=22:00
QUIET_HOURS_END=07:00

# ── 10. Community Sanctuary Feature Flags ──
# 1-on-1 peer matching is strictly OFF by default
ENABLE_PEER_MATCHING=false
