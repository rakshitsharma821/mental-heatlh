diff --git a/frontend/src/components/admin/StatusLanes.jsx b/frontend/src/components/admin/StatusLanes.jsx
new file mode 100644
index 0000000..21a2372
--- /dev/null
+++ b/frontend/src/components/admin/StatusLanes.jsx
@@ -0,0 +1,29 @@
+import React from 'react';
+
+/**
+ * Lane strip: groups `items` by `field` and shows one lane per distinct value found in the data
+ * (nothing is hard-coded — lanes appear only for statuses that exist). Each lane is a tall ruled
+ * column with a count and the first few labels, like pigeon-holes on a desk.
+ */
+export default function StatusLanes({ items = [], field, label, max = 4, title }) {
+  const lanes = new Map();
+  items.forEach((it) => {
+    const key = it?.[field] || 'unspecified';
+    if (!lanes.has(key)) lanes.set(key, []);
+    lanes.get(key).push(it);
+  });
+  if (lanes.size === 0) return null;
+  return (
+    <div className="lanes" role="list" aria-label={title || 'Grouped by status'}>
+      {[...lanes.entries()].map(([key, list]) => (
+        <section key={key} className="lane" role="listitem" data-s={key}>
+          <header><span className="lane-k">{String(key).replace(/_/g, ' ')}</span><b className="num">{list.length}</b></header>
+          <ul>
+            {list.slice(0, max).map((it, i) => <li key={it.id || it.user_id || i}>{label(it)}</li>)}
+            {list.length > max && <li className="more">+ {list.length - max} more</li>}
+          </ul>
+        </section>
+      ))}
+    </div>
+  );
+}
diff --git a/frontend/src/components/common/BrainCanvas.jsx b/frontend/src/components/common/BrainCanvas.jsx
new file mode 100644
index 0000000..b012c38
--- /dev/null
+++ b/frontend/src/components/common/BrainCanvas.jsx
@@ -0,0 +1,19 @@
+import { useEffect, useRef } from 'react';
+import { createBrain } from '../../lib/brain.js';
+import { webglOK, prefersReduced } from '../../lib/env.js';
+
+/** Small self-running brain (client Today / breathing). calm: 0..1 */
+export default function BrainCanvas({ calm = 1, pulses = 24, className = '', label = 'A softly breathing brain illustration' }) {
+  const ref = useRef(null);
+  useEffect(() => {
+    const canvas = ref.current; if (!canvas || !webglOK()) return;
+    const b = createBrain(canvas, { pulses }); let raf, run = true; const t0 = performance.now();
+    const ptr = { x: 0, y: 0 }; const mv = (e) => { ptr.x = e.clientX / innerWidth - .5; ptr.y = e.clientY / innerHeight - .5; }; addEventListener('pointermove', mv);
+    const loop = () => { if (!run) return; b.render((performance.now() - t0) / 1000, calm, ptr); if (!prefersReduced()) raf = requestAnimationFrame(loop); };
+    loop();
+    const io = new IntersectionObserver(([e]) => { const vis = e.isIntersecting; if (vis && !run) { run = true; loop(); } if (!vis) { run = false; cancelAnimationFrame(raf); } }); io.observe(canvas);
+    const ro = new ResizeObserver(() => { b.resize(); if (prefersReduced()) b.render(0, calm, ptr); }); ro.observe(canvas);
+    return () => { run = false; cancelAnimationFrame(raf); io.disconnect(); ro.disconnect(); removeEventListener('pointermove', mv); b.dispose(); };
+  }, [calm, pulses]);
+  return <canvas ref={ref} className={className} role="img" aria-label={label} />;
+}
