+   =================================================================== */
+.tp-page{--tp-sage:#2F5D50;--tp-sage-2:#E6F0EA;--tp-line:rgba(31,45,39,.14);--tp-ink:#1F2D27;
+  background:radial-gradient(55% 40% at 100% 0%,rgba(191,230,209,.55),transparent 70%),radial-gradient(40% 40% at 0% 100%,rgba(217,207,243,.35),transparent 70%),#F6F7F2;
+  padding:0!important}
+.tp-grid{max-width:1240px!important;display:grid;grid-template-columns:230px minmax(0,1fr);column-gap:clamp(24px,3vw,48px);padding:36px clamp(16px,3vw,40px) 90px}
+.tp-grid>*{grid-column:2;min-width:0}
+.tp-grid>.tp-head{grid-column:1/-1}
+
+/* header: name as a masthead, availability as a switch-like pill */
+.tp-head{border-bottom:1px solid var(--tp-line)!important;padding-bottom:22px!important;margin-bottom:26px!important}
+.tp-head h1{font-size:clamp(2rem,3.6vw,3rem)!important;letter-spacing:-.025em;font-weight:420}
+.tp-head span:first-child{color:var(--tp-sage)!important;letter-spacing:.2em!important}
+.tp-head code{font-family:var(--font-sans);font-variant-numeric:tabular-nums;background:var(--tp-sage-2);padding:1px 7px;border-radius:5px;font-size:.8rem}
+.tp-head .btn-ghost{background:#fff!important}
+
+/* tabs → vertical rail with a sliding bar */
+.tp-grid>.desk-tabs{grid-column:1;grid-row:2/span 40;align-self:start;position:sticky;top:84px;flex-direction:column;border-bottom:0;gap:0;margin:0;overflow:visible;border-left:1px solid var(--tp-line)}
+.tp-grid>.desk-tabs .desk-tab{text-align:left;padding:13px 18px;font-size:.95rem;white-space:normal;color:var(--text-secondary)}
+.tp-grid>.desk-tabs .desk-tab::after{left:-1px;right:auto;top:8px;bottom:8px;width:3px;height:auto;background:var(--tp-sage);transform:scaleY(0);transform-origin:top}
+.tp-grid>.desk-tabs .desk-tab:hover::after,.tp-grid>.desk-tabs .desk-tab.on::after{transform:scaleY(1)}
+.tp-grid>.desk-tabs .desk-tab.on{color:var(--tp-ink);font-weight:650;background:linear-gradient(90deg,rgba(47,93,80,.09),transparent)}
+
+/* cards: paper with soft depth, not glass tiles */
+.tp-page .glass-card{border-radius:14px!important;background:#fff;box-shadow:0 1px 0 rgba(31,45,39,.04),0 22px 40px -30px rgba(31,45,39,.45)}
+.tp-page h2,.tp-page h3{font-weight:430!important;letter-spacing:-.015em}
+
+/* ---- day-sheet: sessions as a vertical timeline ---- */
+.tp-timeline{position:relative;gap:0!important;padding-left:30px}
+.tp-timeline::before{content:"";position:absolute;left:8px;top:14px;bottom:14px;width:2px;background:linear-gradient(var(--tp-line),var(--tp-line))}
+.tp-session{position:relative;border-radius:14px!important;margin:8px 0;background:#fff!important;transition:transform .35s var(--ease),box-shadow .35s;animation:tpSlide .6s var(--ease) both}
+.tp-session:hover{transform:translateX(5px);box-shadow:0 22px 40px -26px rgba(31,45,39,.5)}
+.tp-session::before{content:"";position:absolute;left:-27px;top:26px;width:14px;height:14px;border-radius:50%;background:#F6F7F2;border:2px solid var(--tp-sage);z-index:1}
+.tp-session[data-status="assigned"]::before{background:var(--tp-sage);animation:tpPing 2.6s ease-out infinite}
+.tp-session[data-status="confirmed"]::before{background:var(--tp-sage)}
+.tp-session[data-status="completed"],.tp-session[data-status="therapist_declined"]{opacity:.62}
+.tp-session[data-status="assigned"]{border-left:3px solid var(--tp-sage)!important}
+@keyframes tpPing{0%{box-shadow:0 0 0 0 rgba(47,93,80,.35)}70%{box-shadow:0 0 0 12px rgba(47,93,80,0)}100%{box-shadow:0 0 0 0 rgba(47,93,80,0)}}
+@keyframes tpSlide{from{opacity:0;transform:translateX(-14px)}}
+
+/* ---- credential ledger ---- */
+.tp-ledger thead tr{border-bottom:2px solid var(--tp-ink)!important}
+.tp-ledger th{font-size:.7rem!important;letter-spacing:.14em;text-transform:uppercase;font-weight:600!important;color:var(--text-muted)!important}
+.tp-ledger tbody tr{transition:background .2s}.tp-ledger tbody tr:hover{background:rgba(47,93,80,.05)}
+.tp-stamp{border-radius:3px!important;background:transparent!important;border:1.5px solid currentColor;letter-spacing:.12em;text-transform:uppercase;transform:rotate(-2deg);display:inline-block;font-weight:700}
+.tp-stamp[data-state="approved"],.tp-stamp[data-state="verified"]{color:#2F7A58!important}
+.tp-stamp[data-state="rejected"]{color:#B4432F!important}
+.tp-doc-grid .glass-card{transition:transform .35s var(--ease),box-shadow .35s;transform:perspective(900px) rotateX(0) rotateY(0)}
+.tp-doc-grid .glass-card:hover{transform:perspective(900px) rotateX(2deg) translateY(-3px);box-shadow:0 30px 50px -30px rgba(31,45,39,.5)}
+
+/* ---- weekly availability: soft slots with depth ---- */
+.tp-day{border-radius:12px!important;transition:transform .35s var(--ease),box-shadow .35s,background .3s;transform:perspective(900px) translateZ(0)}
+.tp-day[data-on="true"]{background:linear-gradient(95deg,#E6F0EA,#fff 60%)!important;border-color:rgba(47,93,80,.3)!important;box-shadow:0 14px 26px -22px rgba(47,93,80,.7)}
+.tp-day[data-on="true"]:hover{transform:perspective(900px) translateZ(14px) translateY(-2px)}
+.tp-day[data-on="false"]{opacity:.75}
+.tp-day input[type="checkbox"]{accent-color:var(--tp-sage);width:18px;height:18px}
+
+/* buttons / inputs inside the portal */
+.tp-page .btn-primary{background:var(--tp-sage)!important}
+.tp-page .input-field{border-radius:10px}
+
+@media (max-width:900px){
+  .tp-grid{grid-template-columns:1fr;padding:22px 16px 90px}
+  .tp-grid>*,.tp-grid>.tp-head{grid-column:1}
+  .tp-grid>.desk-tabs{grid-column:1;grid-row:auto;position:static;flex-direction:row;overflow-x:auto;border-left:0;border-bottom:1px solid var(--tp-line);margin-bottom:20px}
+  .tp-grid>.desk-tabs .desk-tab{white-space:nowrap;padding:11px 14px}
+  .tp-grid>.desk-tabs .desk-tab::after{left:12px;right:12px;top:auto;bottom:-1px;width:auto;height:2px;transform:scaleX(0);transform-origin:left}
+  .tp-grid>.desk-tabs .desk-tab:hover::after,.tp-grid>.desk-tabs .desk-tab.on::after{transform:scaleX(1)}
+}
+@media (prefers-reduced-motion:reduce){.tp-session,.tp-session::before,.tp-day,.tp-doc-grid .glass-card{animation:none!important;transition:none!important}}
